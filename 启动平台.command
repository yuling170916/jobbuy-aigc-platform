#!/bin/bash
# ============================================
#  Jobbuy AIGC 平台 · 本地一键启动器
#  用法：双击本文件即可（首次使用见下方说明）
# ============================================

cd "$(dirname "$0")" || exit 1

# 首次运行：如果依赖没装过，先自动安装
if [ ! -d "node_modules" ]; then
  echo "首次运行，正在安装依赖（约 1-2 分钟）..."
  npm install
fi

echo ""
echo "======================================"
echo "  Jobbuy AIGC 平台启动中..."
echo "  浏览器会自动打开 http://localhost:3000"
echo "  想关闭平台：直接关掉这个黑色窗口即可"
echo "======================================"
echo ""

# 3 秒后自动打开浏览器
( sleep 3 && open "http://localhost:3000" ) &

# 启动开发服务器（保持运行）
npm run dev
